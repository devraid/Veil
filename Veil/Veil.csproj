<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <FrontendRoot>$(MSBuildProjectDirectory)\..\frontend</FrontendRoot>
    <FrontendDist>$(FrontendRoot)\dist</FrontendDist>
    <FrontendArchive>$(IntermediateOutputPath)frontend.zip</FrontendArchive>
    <PublishDir>$(MSBuildProjectDirectory)\..\publish\win-x64\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3719.77" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(FrontendArchive)" LogicalName="Veil.Frontend.zip" />
    <Compile Update="Data\Migrations\**\*.cs">
      <Visible>true</Visible>
    </Compile>
  </ItemGroup>

  <Target Name="BuildFrontend" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="npm ci --prefix &quot;$(FrontendRoot)&quot;" WorkingDirectory="$(FrontendRoot)" Condition="!Exists('$(FrontendRoot)\node_modules')" />
    <Exec Command="npm run build --prefix &quot;$(FrontendRoot)&quot;" WorkingDirectory="$(FrontendRoot)" />
    <Error Condition="!Exists('$(FrontendDist)\index.html')" Text="The frontend build did not produce $(FrontendDist)\index.html." />
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;Compress-Archive -Path '$(FrontendDist)\*' -DestinationPath '$(FrontendArchive)' -Force&quot;" />
  </Target>

  <Target Name="CleanFrontendArchiveAfterBuild" AfterTargets="Build">
    <Delete Files="$(FrontendArchive)" />
  </Target>

  <Target Name="CleanFrontendArchiveAfterPublish" AfterTargets="Publish">
    <Delete Files="$(FrontendArchive)" />
  </Target>

  <Target Name="CleanLegacyPublishArtifacts" BeforeTargets="Publish">
    <RemoveDir Directories="$(MSBuildProjectDirectory)\..\artifacts" />
  </Target>

  <Target Name="CleanPublishFolderAfterPublish" AfterTargets="Publish">
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;Get-ChildItem -LiteralPath '$(PublishDir)' -Force | Where-Object { $_.Name -ne 'Veil.exe' } | Remove-Item -Recurse -Force&quot;" />
  </Target>

</Project>
