{
  "name": "veil-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run format && vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "check": "biome check .",
    "format": "biome format --write .",
